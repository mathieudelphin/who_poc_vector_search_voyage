# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=poc-who
OPENEDX_MODULESTORE_DB_NAME=openedx_ulmo

# Voyage AI / MongoDB AI Services (Automated Embedding + Reranking)
# VOYAGE_EMBED_MODEL controls the default model for Atlas Automated Embedding (`voyage-4`)
VOYAGE_EMBED_MODEL=voyage-4

# VOYAGE_API_KEY is used by the backend service to call the Voyage Rerank endpoint (`rerank-3` or `rerank-3-lite`)
VOYAGE_API_KEY=your-mongodb-ai-or-voyage-api-key
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
# Use https://eu.ai.mongodb.com/v1 for EU endpoints or https://api.voyageai.com/v1 for direct Voyage AI
VOYAGE_RERANK_MODEL=rerank-3
VOYAGE_RERANK_THRESHOLD=0.50
VOYAGE_MIN_INTERVAL_SECONDS=0.65

# Azure AI Foundry / OpenAI Responses Gateway (Step B6 Grounded Answer Generation)
AI_GATEWAY_API_KEY=your-ai-foundry-or-openai-api-key
AI_GATEWAY_SECONDARY_KEY=
AI_GATEWAY_BASE_URL=https://api.openai.com/v1
AI_GATEWAY_MODEL=gpt-4o-mini

# Optional Alternative: Azure OpenAI Deployment or Standard OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_2_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview
OPENAI_API_KEY=

# Chat History Retention (TTL Index in seconds, default 90 days = 7776000)
CHAT_TURNS_TTL_SECONDS=7776000
